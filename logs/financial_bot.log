2025-08-26 16:59:36,684 - src.nlu.gigachat_client - DEBUG - [gigachat_client.py:83] - extract_intent_and_entities - Extracting intent/entities from: 'С какого региона компания' with context: {'current_inn': '3620007636', 'company_name': 'Компания с ИНН 3620007636', 'analysis_report': {'company_info': {'inn': '3620007636', 'company_url': 'https://checko.ru/company/agrofirma-pavlovskaya-niva-1023601069106', 'company_name': 'Компания с ИНН 3620007636', 'general_info': {'director': 'Савченко Иван Тихонович', 'employees': '630 человек-29', 'revenue (за 2024 год)': '3,1 млрд руб.', 'address': '396422, Воронежская область, м. р-н Павловский, г. п. город Павловск, г. Павловск, ул. Покровская, д. 11'}, 'okved_data': {'main_okved': {'code': '01.11.1', 'name': 'Выращивание зерновых культур'}, 'additional_okved': [{'code': '01.11', 'name': 'Выращивание зерновых (кроме риса), зернобобовых культур и семян масличных культур'}, {'code': '01.11.2', 'name': 'Выращивание зернобобовых культур'}, {'code': '01.11.3', 'name': 'Выращивание семян масличных культур'}, {'code': '01.11.31', 'name': 'Выращивание семян подсолнечника'}, {'code': '01.11.33', 'name': 'Выращивание семян соевых бобов'}, {'code': '01.13.1', 'name': 'Выращивание овощей'}, {'code': '01.13.3', 'name': 'Выращивание столовых корнеплодных и клубнеплодных культур с высоким содержанием крахмала или инулина'}, {'code': '01.13.51', 'name': 'Выращивание сахарной свеклы'}, {'code': '01.41', 'name': 'Разведение молочного крупного рогатого скота, производство сырого молока'}, {'code': '01.42', 'name': 'Разведение прочих пород крупного рогатого скота и буйволов, производство спермы'}, {'code': '10.41.2', 'name': 'Производство нерафинированных растительных масел и их фракций'}, {'code': '10.71', 'name': 'Производство хлеба и мучных кондитерских изделий, тортов и пирожных недлительного хранения'}, {'code': '10.73.1', 'name': 'Производство макаронных изделий'}, {'code': '46.61.1', 'name': 'Торговля оптовая сельскохозяйственными и лесохозяйственными машинами, оборудованием и инструментами, включая тракторы'}, {'code': '46.90', 'name': 'Торговля оптовая неспециализированная'}, {'code': '47.9', 'name': 'Торговля розничная вне магазинов, палаток, рынков'}, {'code': '52.29', 'name': 'Деятельность вспомогательная прочая, связанная с перевозками'}, {'code': '69.20.2', 'name': 'Деятельность по оказанию услуг в области бухгалтерского учета'}, {'code': '72.19', 'name': 'Научные исследования и разработки в области естественных и технических наук прочие'}, {'code': '77.31', 'name': 'Аренда и лизинг сельскохозяйственных машин и оборудования'}, {'code': '77.39.11', 'name': 'Аренда и лизинг прочего автомобильного транспорта и оборудования'}, {'code': '86.90', 'name': 'Деятельность в области медицины прочая'}]}, 'founders_data': ['Сведения об учредителях не найдены.'], 'error': None}, 'agroinvestor_news': [{'title': 'ИКАРповысил прогноз урожая зерна', 'summary': 'Институт конъюнктуры аграрного рынка(ИКАР) повысил прогноз урожая пшеницы с 84,5 млн т до 85,5 млн т, пишет «Интерфакс». Оценка сбора всего зерна увеличена со 130,5 млн т до 132 млн т. Экспортный потенциал также пересмотрен в сторону увеличения\xa0— с 53 млн т до 54,5 млн т зерна, включая 42,5 млн т пшеницы (прежняя оценка\xa0— 41,5 млн т). Основными факторами повышения прогнозов стали более высокая, чем ожидалось, урожайность пшеницы и ячменя в Центре и Поволжье, а также ожидание высокого урожая в Сибири и на Урале. «Хотя имеются существенные погодные риски: в ключевых регионах уборки идут дожди»,\xa0— отметил гендиректорИКАРДмитрий Рылько.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/ikar/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Минтруд предложил снизить долю иностранных работников в овощеводстве', 'summary': 'Минтруд предлагает в 2026 году снизить по сравнению с 2025-м долю иностранных работников в девяти экономических сферах, сообщается на сайте ведомства. Так, показатель для овощеводства, оптовой торговли древесным сырьем, лесо- и пиломатериалами, а также в лесоводстве и лесозаготовке, обработке древесины и производства изделий из нее и пробки ограничение составит не более 40%, ранее было до 50%. Кроме того, ведомство предлагает уменьшить долю и в сферах обслуживания населения: в организациях общепита не менее 50% сотрудников должны быть гражданами России, ранее таких ограничений по иностранным работникам не было. Однако производители овощей и так испытывают острую нехватку рабочих рук, что частично компенсируется иностранными сотрудниками.', 'full_article_url': 'https://www.agroinvestor.ru/markets/news/44684-mintrud-predlozhil-snizit-dolyu-inostrannykh-rabotnikov-v-ovoshchevodstve/', 'full_text': 'Минтруд предлагает в 2026 году снизить по сравнению с 2025-м долю иностранных работников в девяти экономических сферах, сообщается на сайте ведомства. Так, показатель для овощеводства, оптовой торговли древесным сырьем, лесо- и пиломатериалами, а также в лесоводстве и лесозаготовке, обработке древесины и производства изделий из нее и пробки ограничение составит не более 40%, ранее было до 50%. Кроме того, ведомство предлагает уменьшить долю и в сферах обслуживания населения: в организациях общепита не менее 50% сотрудников должны быть гражданами России, ранее таких ограничений по иностранным работникам не было. Также Минтруд предлагает ограничить трудоустройство мигрантов в сфере розничной торговли алкоголем и табаком в специализированных магазинах, сократив их долю с 15% до нуля. При этом в сфере розничной торговли в аптеках, нестационарных торговых объектах и на рынках, а также вне магазинов и палаток уже действует полный запрет на иностранных работников, нулевой показатель сохранится и на 2026 год. Гендиректор компании«Технологии Роста»Тамара Решетникова говорит, что производители овощей и так испытывают острую нехватку рабочих рук, что частично компенсируется иностранными сотрудниками. «Если их доля будет снижена, то с учетом четкого тренда на “обеление”, усиление фискального надзора, налоговой нагрузки, это точно приведет к тому, что затраты на ФОТ вырастут. Хотя и сейчас доля фонда оплаты труда во многих теплицах превышает даже расходы на электроэнергию\xa0— 30-40% от себестоимости, а если они вырастут еще сильнее, то это однозначно приведет к росту отпускных цен или снижению маржинальности работы овощеводов, которая в этом году и так снизилась из-за роста затрат»,\xa0— прокомментировала Решетникова «Агроинвестору». Увеличение себестоимости и рост цен при производстве овощей сезонного сбора (картофель, лук, морковь и др.) может стать катастрофическим, продолжает она. Поэтому, считает эксперт, снижать долю иностранных работников некорректно. «В овощеводстве мало желающих работать (среди граждан России)\xa0— это тяжелый труд, а если речь идет об открытом грунте, то это сезонная работа. Почему бы не приглашать сезонных рабочих из других стран, которые готовы работать за меньшие деньги?»,\xa0— рассуждает она. Сейчас в овощеводстве и так достаточно тяжелая ситуация, говорит исполнительный директор Картофельного союза Алексей Красильников. Например, цены на сельхозтехнику сильно выросли, в то время как кредиты для бизнеса практически недоступны из-за высокой ставки, плюс еще и планируется сократить долю иностранных сотрудников в условиях существующего дефицита рабочих рук. «За последние два года ставки по оплате труда выросли вдвое\xa0— в прошлом году ставка за рабочую смену составляла от 5\xa0тыс.\xa0руб. и выше»,\xa0— прокомментировал Красильников «Агроинвестору». Ранее в Краснодарском крае уже был введен полный запрет на использование иностранных рабочих по патенту в сельском хозяйстве, напоминает он. Это, конечно, проблематично для бизнеса, хотя благие намерения этого ограничения ясны\xa0— рост зарплат для местных сотрудников, но в итоге увеличившиеся затраты были переложены в себестоимость и стоимость продукции. «Понятно, что нужно сокращать долю ручного труда, но приходится возвращаться к вопросу стоимости механизации и доступности кредитов»,\xa0— заключил эксперт. Больше новостей АПК\xa0—в нашем Telegram-канале.\xa0Подписывайтесь!'}, {'title': 'Экспортные цены на российскую пшеницу снова пошли вверх', 'summary': 'Цены на российскую пшеницу с протеином 12,5% с поставкой в августе-сентябре на прошлой неделе выросли на $5, до $242/т FOB, тогда как год назад они составляли около $220/т, сообщил аналитический центр«Русагротранса». Однако спрос со стороны покупателей оставался неактивным. Цены на французскую пшеницу укрепились на $8,5, до $237/т, американская и австралийская подорожала на $4, до $218/т и $255/т соответственно. Цены на румынскую пшеницу снизились на $1, до $243/т, на аргентинскую\xa0— остались без изменений $234/т.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/rusagrotrans/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Импорт картофеля в этом сезоне вырос более чем втрое', 'summary': 'В этом сезоне импорт картофеля практически достиг рекорда и составил 850 тыс. т против примерно 250 тыс. т в 2024 году, рассказал «Агроинвестору» исполнительный директор Картофельного союза Алексей Красильников. Рост поставок связан с тем, что в декабре 2024-го была обнулена ввозная пошлина на картофель в объеме 300 тыс. т, в мае\xa0— еще на 150 тыс. т. «Этот импортный картофель сохранялся на наших прилавках, складах, практически до середины июля, и вступил в жесткую конкуренцию с нашим ранним картофелем, который и так продавался по цене ниже себестоимости»,\xa0— говорит Красильников. Кроме того, продолжает он, на снижение цен повлияли определенные меры в отношении экспорта раннего российского картофеля в Белоруссию, Казахстан\xa0— отгрузки были ограничены.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/agroinvestor/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Урожай масличных в этом году может превысить 33,5 млн тонн', 'summary': 'По прогнозу Масложирового союза, в этом году урожай масличных в России может превысить 33,5 млн т (с учетом новых регионов, в 2024-м\xa0— 28,6 млн т), пишет поле.рф. В то же время профессиональные аналитики, опрошенные Центром ценовых индексов (ЦЦИ), оценивают сбор подсолнечника, рапса и сои в сезоне-2025/26 в 31,6 млн т, а с учетом новых регионов\xa0— 33,1 млн т, что станет новым рекордом. Прогнозы урожая рапса были повышены с 5,1 млн т до 5,3 млн т, сои\xa0— с 7,7 до 8 млн т, сбор подсолнечника, по прогнозам аналитиков, составит 18,3 млн т, что станет абсолютным рекордом.Институт конъюнктуры аграрного рынка(ИКАР) оценивает урожай подсолнечника в этом году в 17,8-18 млн т, рапса\xa0— в 5-5,1 млн т, сои\xa0— в 7,9-8 млн т (без учета новых регионов). Согласно оценкамOleoScope, в этом году валовый сбор подсолнечника составит 18,2 млн т (с учетом новых территорий\xa0— 19,5 млн т), рапса\xa0— 5,1 млн т (5,2 млн т), сои\xa0— 7,9 млн т.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/ikar/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': '«Август-Агро» в этом году рассчитывает увеличить урожай пшеницы', 'summary': 'Хозяйства «Август-Агро» несмотря на непростые погодные условия продолжают уборку урожая, показатели пока опережают прошлогодние, рассказал гендиректор компании Айдар Галяутдинов в ходе пресс-тура, приуроченного к 35-летию фирмы«Август». В этом году агрохолдинг планирует собрать 320-350 тыс. т пшеницы против около 250 тыс. т в 2024-м. Однако на фоне неблагоприятной рыночной конъюнктуры компания сокращает посевы агрокультуры: под урожай этого года они уменьшились на 10-12%, площадь сева озимой пшеницы под урожай 2026-го также планируется снизить еще на 10-15%.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/avgust/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'ГК «Мелком» впервые в России выпустит утилитарные цифровые права на пшеницу', 'summary': 'ГК «Мелком» впервые в России использует для привлечения финансирования механизм выпуска утилитарных цифровых прав (УЦП), обеспеченных поставкой продовольственной пшеницы. Этот шаг открывает новый этап в развитии цифрового товарного рынка в стране и предлагает бизнесу не просто замену классическому кредиту, а стратегический инструмент секьюритизации его товарных потоков и управления оборотным капиталом, альтернативный существующим, сообщила компания. Максимальный объем привлечения\xa0— 510\xa0млн\xa0руб., что эквивалентно 34 тыс. т пшеницы. Каждое утилитарное цифровое право представляет собой право требования 100\xa0кг пшеницы 3-го класса.', 'full_article_url': 'https://www.agroinvestor.ru/companies/news/44695-gk-melkom-vpervye-v-rossii-vypustit-utilitarnye-tsifrovye-prava-na-pshenitsu/', 'full_text': 'ГК «Мелком» впервые в России использует для привлечения финансирования механизм выпуска утилитарных цифровых прав (УЦП), обеспеченных поставкой продовольственной пшеницы. Этот шаг открывает новый этап в развитии цифрового товарного рынка в стране и предлагает бизнесу не просто замену классическому кредиту, а стратегический инструмент секьюритизации его товарных потоков и управления оборотным капиталом, альтернативный существующим, сообщила компания. Максимальный объем привлечения\xa0— 510\xa0млн\xa0руб., что эквивалентно 34 тыс. т пшеницы\xa0— около 12% годовой потребности в ней предприятий группы. Каждое утилитарное цифровое право представляет собой право требования 100\xa0кг пшеницы 3-го класса. Цена УЦП при размещении\xa0— 1,5\xa0тыс.\xa0руб., она устанавливалась с учетом данных Института конъюнктуры аграрного рынка и корректировалась на дисконт. Базисы и сроки поставки: FCA Тверь/Истра, май-июль 2026 года, срок привлечения средств\xa0— девять месяцев. «Мы видим в этом не разовую инициативу, а начало нового этапа в аграрном финансировании,\xa0— отметил первый заместитель гендиректора\xa0ГК «Мелком» Михаил Дорофеев. —\xa0УЦП позволяют нам привлекать средства под реальный товарный актив\xa0— гибко, без избыточной долговой нагрузки, а для инвесторов получить дополнительную прибыль за счет устойчивых трендов на рынке зерна». Ключевым партнером в выпуске нового финансового инструмента стал Петербургский технический центр. «Совместно с\xa0ГК “Мелком” мы проделали комплексную работу для того, чтобы финальный продукт получился инвестиционно-привлекательным, предоставляя клиентам возможность копить и сберегать в реальных товарных активах,\xa0— прокомментировал исполнительный директор центра Никита Захаров. —\xa0Принципиально важно, что в дальнейшем будет сформирован вторичный рынок цифровых свидетельств на выпущенные УЦП, что сделает данный инструмент доступным широкому кругу участников биржевого фондового рынка. При этом сам инструмент сохраняет связь с физическим рынком и предполагает возможность получения базового актива при исполнении». Больше новостей АПК\xa0—в нашем Telegram-канале.\xa0Подписывайтесь!'}], 'ria_news_forecast': [{'title': 'Мировые цены на продовольствие в июле выросли до максимума с 2023 года', 'full_article_url': 'https://ria.ru/20250808/produkty-2034129363.html', 'full_text': 'МОСКВА, 8 авг - РИА Новости.Агрегированный показатель мировых цен на продовольствие в июле увеличился до самого высокого значения с февраля 2023 года, а главными источниками роста стали цены на мясо, на историческом рекорде, и на растительное масло - на трехлетнем, сообщила Продовольственная и сельскохозяйственная организация ООН (ФАО). "Среднее значение Индекса продовольственных цен ФАО (ИПЦФ) в июле 2025 года составило 130,1 пункта, что на 2,1 пункта (1,6%) выше уровня июня. Рост значения индексов цен на мясо и растительные масла нивелировал снижение значений индексов цен на зерновые, молочную продукцию и сахар", - говорится всообщении. Как следует из более детальных данных, которые предоставляетФАО, рост в более чем 2 пункта - максимальный с октября, а уровень выше 130 пунктов - рекордный с февраля 2023 года. Пиковый уровень составлял 160,2 пункта, он был достигнут в марте 2022 года, свидетельствуют данные организации. Наиболее заметный рост в абсолютном выражении у индекса цен на растительные масла - на 11,1 пункта (7,1%) к июню, до 166,8 пункта, это самый высокий уровень с июля 2022 года. Такая динамика объясняется удорожанием пальмового и соевого (из-за устойчивого спроса), а также подсолнечного (из-за снижения поставок) масла при незначительном снижения цен на рапсовое масло, сообщает ФАО. Индекс цен на мясо вырос на 1,5 пункта (1,2%), до 127,3 пункта, что стало самым высоким значением как минимум с 1990 года, с которого ФАО считает. В основном такая динамика связана с ростом цен на говядину и баранину, мясо птицы также несколько подорожало, тогда как свинина подешевела. Говядина подорожала до нового рекорда в связи с высоким импортным спросом, особенно со стороныКитаяиСША, баранина - из-за снижения экспортного предложения из Океании. Сократился сильнее других индекс цен на зерновые - на 0,8 пункта (0,8%), до 106,5 пункта. Организация отмечает рост экспортных цен на ячмень и кукурузу, и снижение - на сорго и пшеницу. В частности, давление на стоимость пшеницы оказало высокое сезонное предложение в Северном полушарии, где продолжается уборка урожая озимой пшеницы. Удорожание кукурузы ФАО объясняет низкой торговой активностью со стороны фермеров, засушливыми условиями вВосточной Европеи снижением экспорта изАргентиныиБразилии. Индекс цен на молочную продукцию снизился на 0,2 пункта (0,1%) к июню, до 155,3 пункта. Это стало первым снижением индекса с апреля 2024 года, отмечает ФАО. Такая динамика связывается с сокращением цен на сливочное масло и сухое молоко при продолжающемся росте котировок сыра. Если смотреть более детально, то индекс цен на сливочное масло упал на 1,1% - это первое снижение за шесть месяцев, оно обусловлено ростом производства и накоплением запасов. А удорожание сыра связано с устойчивым спросом со стороны азиатских и ближневосточных рынков и сокращением экспортного предложения вЕС, говорится в релизе. Наконец, индекс цен на сахар также уменьшился - на 0,2 пункта (0,2%) в месячном выражении, до 103,3 пункта, это пятый месяц снижения подряд, а также минимальный уровень с апреля 2021 года, следует из данных ФАО. Организация ссылается на прогнозы роста производства вИндиииТаиланде, а также благоприятные погодные условия в Бразилии.'}, {'title': 'Минсельхоз сохранил прогноз урожая зерновых на 2025 год', 'full_article_url': 'https://ria.ru/20250728/minselhoz-2031841877.html', 'full_text': 'МОСКВА, 28 июл - РИА Новости.Минсельхоз России сохраняет прогноз урожая зерновых и зернобобовых на уровне 135 миллиона тонн в текущем году при благоприятных погодных условиях во время уборки, сообщили журналистам в пресс-службе ведомства. "Минсельхозсохраняет прогноз по производству зерновых и зернобобовых культур на уровне 135 миллиона тонн при благоприятных погодных условиях в период уборки урожая", - заявили там. "В текущем году в отдельных регионах юга страны, в частности,Ростовской области,Республике Крыми некоторых районахКраснодарского краясложились неблагоприятные условия для формирования урожая зерновых культур", - сообщили также в ведомстве. "Вместе с тем в большинстве регионов Центрального, Приволжского,Северо-Кавказского федеральных округов, а также в отдельных южных регионах (Адыгея,Волгоград) фактическая урожайность выше прошлогодних показателей", - указывает Минсельхоз.'}, {'title': '\ufeffМишустин проведет в Забайкалье совещание по вопросу экспорта зерна', 'full_article_url': 'https://ria.ru/20250722/mishustin-2030512898.html', 'full_text': 'МОСКВА, 22 июл - РИА Новости.Премьер-министр РФ Михаил Мишустин в рамках рабочей поездки по дальневосточным регионам отправится в Забайкальский край, где во вторник проведет совещание о развитии экспорта зерна. Глава кабмина накануне работал вАмурской области.Мишустиносмотрел строящийся терминал международного аэропорта вБлаговещенске, посетил автомобильный пункт пропуска "Кани-Курган" - один из ключевых погранпереходов на границеРоссиииКитая, а также ознакомился с работой крупнейшего наДальнем Востокелогистического хаба "Каникурган". Кроме того, премьер в столице Приамурья посетил строящийся Дом российско-китайской дружбы и провел отдельную встречу с губернатором Амурской областиВасилием Орловым. Во вторник Мишустин прибудет вЧиту, где у него запланировано совещание о развитии экспорта зерна. Также в рабочем графике главы правительства посещение Забайкальского краевого перинатального центра и беседа с губернаторомЗабайкальского краяАлександром Осиповым. Сопровождать премьера в этой поездке будут главаМинсельхозаОксана Лут, министр транспортаАндрей Никитини руководитель МинвостокразвитияАлексей Чекунков. ЭКСПОРТ ЗЕРНА Лут в июле сообщила, что министерство сохраняет прогноз по урожаю зерна в 2025 году порядка 135 миллионов тонн, в том числе пшеницы - 90 миллионов тонн. Минсельхоз надеется, что в 2025 году показатели урожая зерна превысят прошлогодние - при условии ожидаемой хорошей погоды, говорила глава министерства в мае. В России применяется гибкая экспортная пошлина на пшеницу, кукурузу и ячмень, которая действует в рамках механизма зернового демпфера. Для расчета используются данные о цене экспортных контрактов, зарегистрированных на бирже, и среднеарифметический курс доллара к рублю Банка России за пять рабочих дней до даты расчета. Полученные средства направляются субъектам РФ в виде субсидий производителям пшеницы, ржи, кукурузы и кормового ячменя. Пошлина на экспорт пшеницы из России, действующая с 16 по 22 июля, составляет 0 рублей, кукурузы - 947,1 рубля за тонну, ячменя - 0 рублей. Недавно Минсельхоз сообщил, что пошлина на экспорт пшеницы и ячменя на период с 23 по 29 июля останется нулевой, на кукурузу - снизится до 840,8 рубля за тонну. Ставка экспортной пошлины на пшеницу и меслин (смесь пшеницы и ржи) рассчитана при индикативной цене 225 долларов за тонну, на ячмень - 192,9 доллара, на кукурузу - 231,7 доллара за тонну. Мишустин в статусе главы правительства не раз ездил на Дальний Восток. Первая поездка в дальневосточные регионы состоялась в августе 2020 года, в течение недели премьер посетилЧукотку,Камчатку, Магаданскую и Амурскую области. Нередко поездки главы правительства на Дальний Восток совмещаются с посещением Сибирского федерального округа. В июле 2021 года Мишустин посетилХабаровский край, Сахалинскую иИркутскую области. В 2023 году Мишустин также совершил ряд рабочих поездок по субъектам Дальневосточного федерального округа и Сибири. Премьер, в частности, посетилВладивосток,Улан-Удэ,НорильскиГорно-Алтайск. В 2024 году городами посещения сталиМагадан,Хабаровск,Новосибирски Горно-Алтайск.'}], 'price_forecast_summary': 'По данным Аналитический хаб прогнозируются цены на: Пшеница 1-го класса 2026 - 13.9 руб/кг без НДС (-4.8% к АППГ), 2027 - 14.3 руб/кг без НДС (+2.9% к АППГ); Пшеница 3-го класса 2026 - 14.7 руб/кг без НДС (-3.3% к АППГ), 2027 - 15.0 руб/кг без НДС (+2.0% к АППГ); Пшеница 5-го класса 2026 - 13.2 руб/кг без НДС (-6.4% к АППГ), 2027 - 13.5 руб/кг без НДС (+2.3% к АППГ); Подсолнечник 2026 - 33.4 руб/кг без НДС (-7.2% к АППГ), 2027 - 34.3 руб/кг без НДС (+2.7% к АППГ); Кукуруза 2026 - 14.4 руб/кг без НДС (+1.4% к АППГ), 2027 - 14.8 руб/кг без НДС (+2.8% к АППГ).', 'programs_analysis': {'passed': [{'program_name': "Программа льготного кредитования 'МСХ'", 'base_conditions': '\n- **Цели кредита:** Оборотное/инвестиционное/проектное финансирование в соответствии с ДКЦ.\n- **Типы кредитов:** Краткосрочные (до 1 года) и инвестиционные (от 2 до 15 лет).\n- **Ставка:** неприоритетное направление - 0,5КС+2%, приоритетное направление - 0,3КС+2%, ИСКЛЮЧЕНИЕ (производство лечеб питания) - 2%\n- **Размер субсидии:** Расчетный годовой размер субсидии зависит от направления:\n  - *Приоритетное:* 0,7 * КС * (Лимит кредита)\n  - *Неприоритетное:* 0,5 * КС * (Лимит кредита)\n  - *Исключение (лечеб. питание):* 1,0 * КС * (Лимит кредита)\n- **Основное требование:** Наличие свободных лимитов субсидий по региону и направлению деятельности заемщика.\n- **Режим кредитования:** НКЛ.\n', 'analysis_data': {'is_priority': True, 'subsidy_rate': 0.7, 'key_rate': 18.0, 'relevant_category': 'Растениеводство', 'max_credit_limit': 600000000, 'calculated_subsidy': 75600000.0, 'rate_text': 'Ставка от Ключевой Ставки ЦБ (18.00% на 26.08.2025).\nРасчет: (0.3 * 18.00% КС) + 2% = **7.40% годовых**.', 'subsidy_text': '**75 600 000.00 рублей**.'}, 'passed': True, 'calculated_conditions': 'Ставка от Ключевой Ставки ЦБ (18.00% на 26.08.2025).\nРасчет: (0.3 * 18.00% КС) + 2% = **7.40% годовых**.', 'manual_steps': '- Предоставить в банк справки: об отсутствии задолженности (ФНС), о статусе сельхозтоваропроизводителя (форма 6-АПК).\n- Расчетный размер годовой субсидии: **75 600 000.00 рублей**.\n\nДополнительно: Подробнее с направлениями целевого использования можно ознакомиться по [ссылке](https://mcx.gov.ru/activity/state-support/measures/preferential-credit/).', 'check_log': ['Шаг 1: Проверка наличия компании в ЕГРЮЛ и базовых данных.', '✅ РЕЗУЛЬТАТ: Компания найдена, данные по ОКВЭД присутствуют.', 'Шаг 2: Анализ ОКВЭД и ранний расчет потенциальных условий.', "   - Определена категория 'Растениеводство' (Приоритет: True).", 'Шаг 3: Проверка соответствия ОКВЭД требованиям программы.', '✅ РЕЗУЛЬТАТ: Найдены соответствующие ОКВЭД: 01.41, 10.41.2, 01.11.2, 01.13.3, 01.11, 01.11.1, 01.11.33, 01.11.3, 01.13.1, 10.73.1, 01.13.51, 01.42, 01.11.31, 10.71.', 'Шаг 4: Проверка доли иностранных учредителей из офшорных зон.', '✅ РЕЗУЛЬТАТ: Доля офшоров (0%) не превышает 25%.']}], 'fixable': [{'program_name': "Программа поддержки 'Беларусь'", 'base_conditions': '\n- **Цели кредита:** Приобретение товаров, произведенных в Республике Беларусь (техника, оборудование и т.д.).\n- **Сумма кредита:** До 90% от стоимости товара. Для продукции ОАО «БЕЛАЗ» - до 70%.\n- **Валюта и срок:** Кредит выдается в рублях РФ на срок до 5 лет.\n- **Общий принцип ставки:** Ставка для заемщика субсидируетс