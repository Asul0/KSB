2025-08-17 18:18:02,446 - src.nlu.gigachat_client - DEBUG - [gigachat_client.py:83] - extract_intent_and_entities - Extracting intent/entities from: 'скорлько можно выдать клиенту кредит' with context: {'current_inn': '3620007636', 'company_name': 'Компания с ИНН 3620007636', 'analysis_report': {'company_info': {'inn': '3620007636', 'company_url': 'https://checko.ru/company/agrofirma-pavlovskaya-niva-1023601069106', 'company_name': 'Компания с ИНН 3620007636', 'general_info': {'director': 'Савченко Иван Тихонович', 'employees': '630 человек-29', 'revenue (за 2024 год)': '3,1 млрд руб.', 'address': '396422, Воронежская область, м. р-н Павловский, г. п. город Павловск, г. Павловск, ул. Покровская, д. 11'}, 'okved_data': {'main_okved': {'code': '01.11.1', 'name': 'Выращивание зерновых культур'}, 'additional_okved': [{'code': '01.11', 'name': 'Выращивание зерновых (кроме риса), зернобобовых культур и семян масличных культур'}, {'code': '01.11.2', 'name': 'Выращивание зернобобовых культур'}, {'code': '01.11.3', 'name': 'Выращивание семян масличных культур'}, {'code': '01.11.31', 'name': 'Выращивание семян подсолнечника'}, {'code': '01.11.33', 'name': 'Выращивание семян соевых бобов'}, {'code': '01.13.1', 'name': 'Выращивание овощей'}, {'code': '01.13.3', 'name': 'Выращивание столовых корнеплодных и клубнеплодных культур с высоким содержанием крахмала или инулина'}, {'code': '01.13.51', 'name': 'Выращивание сахарной свеклы'}, {'code': '01.41', 'name': 'Разведение молочного крупного рогатого скота, производство сырого молока'}, {'code': '01.42', 'name': 'Разведение прочих пород крупного рогатого скота и буйволов, производство спермы'}, {'code': '10.41.2', 'name': 'Производство нерафинированных растительных масел и их фракций'}, {'code': '10.71', 'name': 'Производство хлеба и мучных кондитерских изделий, тортов и пирожных недлительного хранения'}, {'code': '10.73.1', 'name': 'Производство макаронных изделий'}, {'code': '46.61.1', 'name': 'Торговля оптовая сельскохозяйственными и лесохозяйственными машинами, оборудованием и инструментами, включая тракторы'}, {'code': '46.90', 'name': 'Торговля оптовая неспециализированная'}, {'code': '47.9', 'name': 'Торговля розничная вне магазинов, палаток, рынков'}, {'code': '52.29', 'name': 'Деятельность вспомогательная прочая, связанная с перевозками'}, {'code': '69.20.2', 'name': 'Деятельность по оказанию услуг в области бухгалтерского учета'}, {'code': '72.19', 'name': 'Научные исследования и разработки в области естественных и технических наук прочие'}, {'code': '77.31', 'name': 'Аренда и лизинг сельскохозяйственных машин и оборудования'}, {'code': '77.39.11', 'name': 'Аренда и лизинг прочего автомобильного транспорта и оборудования'}, {'code': '86.90', 'name': 'Деятельность в области медицины прочая'}]}, 'founders_data': ['Сведения об учредителях не найдены.'], 'error': None}, 'agroinvestor_news': [{'title': 'Депутаты предложили отменить пошлину на экспорт зерна до 2027 года', 'summary': 'Группа депутатов Госдумы написала письмо председателю правительства Михаилу Мишустину, в котором высказывают обеспокоенность по поводу снижения закупок сельхозтехники на фоне падения доходности аграрной отрасли. Они предлагают ряд мер по выходу из этой ситуации. Основной из них может стать временная\xa0— до 2027 года\xa0— отмена вывозных таможенных пошлин на зерновые культуры и рост доступности льготного финансирования. «Это увеличит доходность сельхозпроизводителей и позволит вернуться к закупкам сельхозтехники, парк которой продолжает критически устаревать»,\xa0— говорится в письме (цитата по «Интерфаксу»). Парламентарии просят Мишустина провести заседание правительства для обсуждения неотложных мер по поддержке АПК.', 'full_article_url': 'https://www.agroinvestor.ru/markets/news/44669-deputaty-predlozhili-otmenit-poshlinu-na-eksport-zerna-do-2027-goda/', 'full_text': 'Группа депутатов Госдумы написала письмо председателю правительства Михаилу Мишустину, в котором высказывают обеспокоенность по поводу снижения закупок сельхозтехники на фоне падения доходности аграрной отрасли. Они предлагают ряд мер по выходу из этой ситуации. Основной из них может стать временная\xa0— до 2027 года\xa0— отмена вывозных таможенных пошлин на зерновые культуры и рост доступности льготного финансирования. «Это увеличит доходность сельхозпроизводителей и позволит вернуться к закупкам сельхозтехники, парк которой продолжает критически устаревать»,\xa0— говорится в письме (цитата по «Интерфаксу»). Документ подписали депутаты Мария Василькова, Сергей Морозов и Юлия Оглоблина. Парламентарии просят Мишустина провести заседание правительства для обсуждения неотложных мер по поддержке АПК. В своем письме депутаты указывают, что сектор испытывает острый дефицит сельскохозяйственной техники: не хватает тракторов, комбайнов, сеялок и других видов прицепного и навесного оборудования. «Аграрии сокращают закупки. Российский рынок сельхозтехники завершил 2024 год с падением на 20%\xa0— впервые с 2017 года объем продаж в денежном выражении сократился до уровня ниже 400\xa0млрд\xa0руб. В первом полугодии 2025 года ситуация ухудшилась: спрос на технику продолжил снижаться, внутренние поставки российских машин упали почти на треть»,\xa0— говорится в обращении к главе правительства. Также авторы письма предлагают ввести заградительную пошлину на ввоз из-за рубежа техники, аналоги которой есть на внутреннем рынке. Они апеллируют к опыту регулирования рынка парфюмерно-косметической продукции и бытовой химии, на котором, согласно письму, эта мера привела к росту отечественного производства в 2024 году на 22%, увеличению отчислений в бюджет. Депутаты также считают необходимым усилить меры по сертификации ввозимого иностранного оборудования на испытательных станциях, пересмотреть действующую модель лизингового финансирования и др. Проблема с доступностью сельхозтехники существовала и в прошлом году, но в текущем она обострилась, считает независимый эксперт аграрного рынка Александр Корбут. «Одна из причин обострения\xa0— рост утильсбора, который поднял цены на технику, и на импортную больше, чем на отечественную»,\xa0— добавляет он. Однако фундаментальная причина проблемы\xa0— утрата доходности при производстве растениеводческой продукции, что в значительной степени было результатом действия пошлин на зерновые и экспортных ограничений в отношении масличных культуры, говорит Корбут. По его мнению, отмена пошлин\xa0— это верное предложение, однако неясно, почему это предлагается сделать только до 2027 года. Введение запретительных пошлин на технику приведет только к одному результату\xa0— к росту цен на отечественную технику, с чем сейчас боретсяМинсельхоз, продолжает Корбут. «По факту предлагается создать условия, в которых на рынке не будет конкуренции. В результате цены вырастут, а качество\xa0— снизится»,\xa0— прокомментировал Корбут «Агроинвестору». По его мнению, проблема с доступностью техники решится при поддержке доходности сельхозпроизводства. Снижение доходов аграриев действительно является одной из причин падения продаж сельхозтехники, говорит председатель правления Ассоциации дилеров сельхозтехники АСХОД Александр Алтынов. Следовательно, для решения проблемы нужно работать с этой причиной, и отмена пошлин в таком случае видится разумным механизмом, который мог бы несколько компенсировать потери от крепкого рубля\xa0— в том числе из-за этого фактора отгрузки за рубеж в последние месяцы сильно просели. «Отмена пошлины\xa0— стимул для продажи на экспорт <...>, и это, безусловно, поможет аграриям, но, с другой стороны, это еще и решение государственного вопроса (по наращиванию экспорта)»,\xa0— считает Алтынов. В то же время введение запретительных пошлин на сельхозтехнику в принципе не имеет никакого отношения к доходам аграриев и тем более не способствует их росту. Кроме того, продолжает Алтынов, давно требует конкретизации формулировка «сельхозтехника, не имеющая российских аналогов». «Наша структура потребления такова, что без импорта мы не обойдемся <...>. Мы видели уже много мер (для повышения продаж сельхозтехники), но хоть раз бы эти неоднократно применявшиеся механизмы показали хоть какую-то эффективность»,\xa0— прокомментровал Алтынов «Агроинвестору». По его мнению, подобные ограничения в некоторой степени имеют смысл для машиностроителей, но не для аграриев. В то же время в ассоциации «Росспецмаш» говорят, что уже принятые меры\xa0— новая программа льготного лизинга, допфинансирование «Росагролизинга», снижение ставки по льготному кредитованию на приобретение сельхозмашин, временное обнуление экспортных пошлин на подсолнечное масло\xa0— очень важны, но они носят точечный характер и направлены на то, чтобы не допустить еще более резкого развития кризиса в сельхозмашиностроении и АПК в целом. Так, сейчас остается ряд проблем, которые не дают надежды на возвращение к положительной динамике на рынке сельхозтехники: запредельно высокая ключевая ставка, низкая доходность агробизнеса и недостаточное финансирование Программы 1432. «Сегодня аграрный бизнес находится в таком положении, что даже на фоне временного обнуления экспортных пошлин на зерно для наращивания объемов его поставок за рубеж аграриям требуется дополнительная поддержка. Например, значительное увеличение субсидирования затрат на транспортировку сельхозпродукции»,\xa0— сообщили «Агроинвестору» в пресс-службе организации. Также для выхода из кризиса отраслевое объединение предлагает предусмотреть ежегодный объем финансирования Программы 1432 в размере 10% от объема отгрузок сельхозтехники на внутренний рынок. «Можно также рассмотреть возможность увеличения размера скидки на самоходную сельхозтехнику, чтобы снизить финансовую нагрузку на аграриев. Сейчас скидка составляет 10-15% в зависимости от региона»,\xa0— допускают в ассоциации. Кроме того, за счет бюджетов и через льготный лизинг стоит реализовывать только технику российского производства, считают в «Росспецмаше». Впрочем, сегодня кризис на рынке сельхозтехники уже находится в той стадии, что даже если принять все эти меры, вряд ли стоит ждать возвращения к прежним темпам обновления парка машин и оборудования в текущем году, добавляют там. Больше новостей АПК\xa0—в нашем Telegram-канале.\xa0Подписывайтесь!'}, {'title': 'Цены на зерно ниже ожиданий производителей', 'summary': 'Агрохолдинг «Степь» уже начал продажи зерна нового урожая, однако цены пока остаются ниже ожидаемых. «Динамика ценообразования пока неудовлетворительная, дальнейшие прогнозы по динамике цен остаются гибкими»,\xa0— рассказал «Агроинвестору» гендиректор компании Андрей Недужко. Текущие цены на пшеницу пока не радуют и гендиректора агрокомплекса «Лабинский», предприятия которого расположены в 17 районах Краснодарского края, Алексея Скоробогатова. Они, по его словам, совершенно не покрывают затрат на производство.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/agroinvestor/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Росстатподвел итоги посевной кампании', 'summary': 'В этом году посевная площадь уменьшилась на 1,11% относительно 2024-го и составила около 79,3 млн га против 80,18 млн га, следует из данныхРосстатапо итогам весеннего учета. В том числе площади зерновых и зернобобовых сократились более чем на 5%, до почти 43,8 млн га: пшеница заняла 26,9 млн га (минус 5,62%), рожь\xa0— 451 тыс. га (минус 32,52%), ячмень\xa0— 6,65 млн га (минус 4,4%). Кукуруза на зерно, предварительно, была посеяна на 2,59 млн га, что на 1,4% меньше, чем в прошлом году.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/rosstat/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Минсельхоз СШАсохранил прогноз экспорта пшеницы из России', 'summary': 'Иностранная сельскохозяйственная служба Минсельхоза США(FAS USDA) в своем отчете за август сохранила прогноз экспорт пшеницы из России в сезоне-2025/26 на уровне 46 млн т (в прошлом сельхозгоду\xa0— 43 млн т, здесь и далее\xa0— без учета Крыма и новых территорий). Также без изменений остался прогноз объема ее производства\xa0— 83,5 млн т (81,6 млн т), переходящие запасы\xa0— 9,39 млн т (10,59 млн т), производство фуражного зерна\xa0— 37,4 млн т (34,77 млн т) и его экспорт\xa0— 7,28 млн т (6,77 млн т), а также урожай кукурузы\xa0— 15 млн т (14 млн т) и ее отгрузки на внешние рынки\xa0— 3,6 млн т (3,3 млн т). Экспорт ячменяFAS USDAпо-прежнему оценивает в 3,4 млн т (3,1 млн т), его производство ожидается на уровне 17,7 млн т (16,25 млн т). Отгрузки овса, по прогнозу, будут на уровне 250 тыс. т (3 тыс. т), его урожай\xa0— 3,3 млн т (3 млн т), ржи\xa0— 30 тыс. т (70 тыс. т) и 760 тыс. т (800 тыс. т) соответственно. Урожай всего зерна в России может составить 121,7 млн т (117,2 млн т).', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/fas-usda/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Посевы гречихи снизились до минимального значения за последние 22 года', 'summary': 'В этом году посевные площади под гречихой составили 746,4 тыс. га, что на 32,3% меньше, чем годом ранее, следует из данныхРосстата. Если рассматривать динамику за прошедшие 36 лет, то меньше размеры площадей были только в 2003-м, когда они составляли 733,4 тыс. га, сравнил «АБ-Центр». Если отталкиваться от среднегодовой урожайности за прошедшие пять лет, то при текущем сокращении площадей сборы гречихи в 2025 году составят около 788 тыс. т, прогнозируют аналитики компании.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/rosstat/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}, {'title': 'Племенным хозяйствам компенсируют до 70% затрат на внедрение геномной селекции', 'summary': 'Правительство будет софинансировать племенным хозяйствам до 70% затрат на исследования племенной ценности и заболеваний животных. Об этом сообщил премьер-министр Михаил Мишустин в ходе оперативного совещания с вице-премьерами. Для выполнения ключевых задач в сфере продовольственной безопасности нужно укреплять технологические возможности агропромышленного комплекса страны, отметил он. Одно из важнейших направлений\xa0— развитие научных разработок в области селекции и генетики, эта работа ведется в рамках нацпроекта по обеспечению технологического лидерства, добавил глава правительства.', 'full_article_url': 'https://www.agroinvestor.ru/animal/news/44650-plemennym-khozyaystvam-kompensiruyut-do-70-zatrat-na-vnedrenie-genomnoy-selektsii/', 'full_text': 'Правительство будет софинансировать племенным хозяйствам до 70% затрат на исследования племенной ценности и заболеваний животных. Об этом сообщил премьер-министр Михаил Мишустин в ходе оперативного совещания с вице-премьерами. Для выполнения ключевых задач в сфере продовольственной безопасности нужно укреплять технологические возможности агропромышленного комплекса страны, отметил он. Одно из важнейших направлений\xa0— развитие научных разработок в области селекции и генетики, эта работа ведется в рамках нацпроекта по обеспечению технологического лидерства, добавил глава правительства. За прошедшие годы в России была сформирована обширная племенная база по 13 видам сельхозживотных, рассказал в ходе совещания вице-премьер Дмитрий Патрушев. По его словам, мы в достаточной мере обеспечиваем себя генетическим материалом в свиноводстве, а также по крупному рогатому скоту мясного и молочного направлений. «С 2023 года у нас активно развивается племенное птицеводство, для чего при поддержке Правительства был создан селекционно-генетический центр «Смена»,\xa0— напомнил он. —\xa0Вместе с тем нам надо развивать качественные характеристики племенного поголовья. Решение этой задачи предусмотрено в рамках нацпроекта "Технологическое обеспечение продовольственной безопасности"». Впервые на федеральном уровне предложены специальные меры поддержки для стимулирования научных разработок и внедрение инновационных методов.\xa0 В первую очередь это касается геномной селекции, которая позволяет быстрее выявлять и закреплять у сельхозживотных полезные продуктивные качества, что значительно ускоряет процессы племенной работы, рассказал Патрушев. По его словам,\xa0 возмещение до 70% затрат на молекулярно-генетические исследования крупного рогатого скота позволит повысить темпы прироста продуктивности сельхозживотных, а значит\xa0— и объемы производства продукции. В этом году на данное направление в федеральном бюджете предусмотрено почти 0,5\xa0млрд\xa0руб. Поддержку смогут получить любые племенные хозяйства, которые будут использовать в работе инструменты геномной селекции. «Рассчитываем, что в 2025 году средства могут получить порядка 400 заявителей. В дальнейшем сумму, предусмотренную на это направление, планируем увеличивать»,\xa0— сказал Патрушев. В перспективе будет сформирована отечественная система геномной оценки, которая позволит эффективнее вести работу по повышению продуктивных качеств животных, добавил он. Больше новостей АПК\xa0—в нашем Telegram-канале. Подписывайтесь!'}, {'title': 'Урожай яблок может быть выше прошлогоднего', 'summary': 'В этом году валовой сбор яблок в промышленном секторе может составить 1,85 млн т, но вполне вероятно, что он может оказаться и на уровне 1,8 млн т. Такой прогноз «Агроинвестору» озвучила гендиректор компании«Технологии Роста»Тамара Решетникова. По прогнозу Минсельхоза, урожай составит 1,9 млн т против 1,7 млн т в прошлом году. Основной объем сбора обеспечат центральные регионы России, поскольку юг пострадал от засухи, говорила в конце июля министр сельского хозяйства Оксана Лут.', 'full_article_url': 'https://www.agroinvestor.ru/companies/a-z/agroinvestor/', 'full_text': 'Это ссылка на карточку компании или другой раздел, а не на статью.'}], 'ria_news_forecast': [{'title': 'Мировые цены на продовольствие в июле выросли до максимума с 2023 года', 'full_article_url': 'https://ria.ru/20250808/produkty-2034129363.html', 'full_text': 'МОСКВА, 8 авг - РИА Новости.Агрегированный показатель мировых цен на продовольствие в июле увеличился до самого высокого значения с февраля 2023 года, а главными источниками роста стали цены на мясо, на историческом рекорде, и на растительное масло - на трехлетнем, сообщила Продовольственная и сельскохозяйственная организация ООН (ФАО). "Среднее значение Индекса продовольственных цен ФАО (ИПЦФ) в июле 2025 года составило 130,1 пункта, что на 2,1 пункта (1,6%) выше уровня июня. Рост значения индексов цен на мясо и растительные масла нивелировал снижение значений индексов цен на зерновые, молочную продукцию и сахар", - говорится всообщении. Как следует из более детальных данных, которые предоставляетФАО, рост в более чем 2 пункта - максимальный с октября, а уровень выше 130 пунктов - рекордный с февраля 2023 года. Пиковый уровень составлял 160,2 пункта, он был достигнут в марте 2022 года, свидетельствуют данные организации. Наиболее заметный рост в абсолютном выражении у индекса цен на растительные масла - на 11,1 пункта (7,1%) к июню, до 166,8 пункта, это самый высокий уровень с июля 2022 года. Такая динамика объясняется удорожанием пальмового и соевого (из-за устойчивого спроса), а также подсолнечного (из-за снижения поставок) масла при незначительном снижения цен на рапсовое масло, сообщает ФАО. Индекс цен на мясо вырос на 1,5 пункта (1,2%), до 127,3 пункта, что стало самым высоким значением как минимум с 1990 года, с которого ФАО считает. В основном такая динамика связана с ростом цен на говядину и баранину, мясо птицы также несколько подорожало, тогда как свинина подешевела. Говядина подорожала до нового рекорда в связи с высоким импортным спросом, особенно со стороныКитаяиСША, баранина - из-за снижения экспортного предложения из Океании. Сократился сильнее других индекс цен на зерновые - на 0,8 пункта (0,8%), до 106,5 пункта. Организация отмечает рост экспортных цен на ячмень и кукурузу, и снижение - на сорго и пшеницу. В частности, давление на стоимость пшеницы оказало высокое сезонное предложение в Северном полушарии, где продолжается уборка урожая озимой пшеницы. Удорожание кукурузы ФАО объясняет низкой торговой активностью со стороны фермеров, засушливыми условиями вВосточной Европеи снижением экспорта изАргентиныиБразилии. Индекс цен на молочную продукцию снизился на 0,2 пункта (0,1%) к июню, до 155,3 пункта. Это стало первым снижением индекса с апреля 2024 года, отмечает ФАО. Такая динамика связывается с сокращением цен на сливочное масло и сухое молоко при продолжающемся росте котировок сыра. Если смотреть более детально, то индекс цен на сливочное масло упал на 1,1% - это первое снижение за шесть месяцев, оно обусловлено ростом производства и накоплением запасов. А удорожание сыра связано с устойчивым спросом со стороны азиатских и ближневосточных рынков и сокращением экспортного предложения вЕС, говорится в релизе. Наконец, индекс цен на сахар также уменьшился - на 0,2 пункта (0,2%) в месячном выражении, до 103,3 пункта, это пятый месяц снижения подряд, а также минимальный уровень с апреля 2021 года, следует из данных ФАО. Организация ссылается на прогнозы роста производства вИндиииТаиланде, а также благоприятные погодные условия в Бразилии.'}, {'title': 'Минсельхоз сохранил прогноз урожая зерновых на 2025 год', 'full_article_url': 'https://ria.ru/20250728/minselhoz-2031841877.html', 'full_text': 'МОСКВА, 28 июл - РИА Новости.Минсельхоз России сохраняет прогноз урожая зерновых и зернобобовых на уровне 135 миллиона тонн в текущем году при благоприятных погодных условиях во время уборки, сообщили журналистам в пресс-службе ведомства. "Минсельхозсохраняет прогноз по производству зерновых и зернобобовых культур на уровне 135 миллиона тонн при благоприятных погодных условиях в период уборки урожая", - заявили там. "В текущем году в отдельных регионах юга страны, в частности,Ростовской области,Республике Крыми некоторых районахКраснодарского краясложились неблагоприятные условия для формирования урожая зерновых культур", - сообщили также в ведомстве. "Вместе с тем в большинстве регионов Центрального, Приволжского,Северо-Кавказского федеральных округов, а также в отдельных южных регионах (Адыгея,Волгоград) фактическая урожайность выше прошлогодних показателей", - указывает Минсельхоз.'}, {'title': '\ufeffМишустин проведет в Забайкалье совещание по вопросу экспорта зерна', 'full_article_url': 'https://ria.ru/20250722/mishustin-2030512898.html', 'full_text': 'МОСКВА, 22 июл - РИА Новости.Премьер-министр РФ Михаил Мишустин в рамках рабочей поездки по дальневосточным регионам отправится в Забайкальский край, где во вторник проведет совещание о развитии экспорта зерна. Глава кабмина накануне работал вАмурской области.Мишустиносмотрел строящийся терминал международного аэропорта вБлаговещенске, посетил автомобильный пункт пропуска "Кани-Курган" - один из ключевых погранпереходов на границеРоссиииКитая, а также ознакомился с работой крупнейшего наДальнем Востокелогистического хаба "Каникурган". Кроме того, премьер в столице Приамурья посетил строящийся Дом российско-китайской дружбы и провел отдельную встречу с губернатором Амурской областиВасилием Орловым. Во вторник Мишустин прибудет вЧиту, где у него запланировано совещание о развитии экспорта зерна. Также в рабочем графике главы правительства посещение Забайкальского краевого перинатального центра и беседа с губернаторомЗабайкальского краяАлександром Осиповым. Сопровождать премьера в этой поездке будут главаМинсельхозаОксана Лут, министр транспортаАндрей Никитини руководитель МинвостокразвитияАлексей Чекунков. ЭКСПОРТ ЗЕРНА Лут в июле сообщила, что министерство сохраняет прогноз по урожаю зерна в 2025 году порядка 135 миллионов тонн, в том числе пшеницы - 90 миллионов тонн. Минсельхоз надеется, что в 2025 году показатели урожая зерна превысят прошлогодние - при условии ожидаемой хорошей погоды, говорила глава министерства в мае. В России применяется гибкая экспортная пошлина на пшеницу, кукурузу и ячмень, которая действует в рамках механизма зернового демпфера. Для расчета используются данные о цене экспортных контрактов, зарегистрированных на бирже, и среднеарифметический курс доллара к рублю Банка России за пять рабочих дней до даты расчета. Полученные средства направляются субъектам РФ в виде субсидий производителям пшеницы, ржи, кукурузы и кормового ячменя. Пошлина на экспорт пшеницы из России, действующая с 16 по 22 июля, составляет 0 рублей, кукурузы - 947,1 рубля за тонну, ячменя - 0 рублей. Недавно Минсельхоз сообщил, что пошлина на экспорт пшеницы и ячменя на период с 23 по 29 июля останется нулевой, на кукурузу - снизится до 840,8 рубля за тонну. Ставка экспортной пошлины на пшеницу и меслин (смесь пшеницы и ржи) рассчитана при индикативной цене 225 долларов за тонну, на ячмень - 192,9 доллара, на кукурузу - 231,7 доллара за тонну. Мишустин в статусе главы правительства не раз ездил на Дальний Восток. Первая поездка в дальневосточные регионы состоялась в августе 2020 года, в течение недели премьер посетилЧукотку,Камчатку, Магаданскую и Амурскую области. Нередко поездки главы правительства на Дальний Восток совмещаются с посещением Сибирского федерального округа. В июле 2021 года Мишустин посетилХабаровский край, Сахалинскую иИркутскую области. В 2023 году Мишустин также совершил ряд рабочих поездок по субъектам Дальневосточного федерального округа и Сибири. Премьер, в частности, посетилВладивосток,Улан-Удэ,НорильскиГорно-Алтайск. В 2024 году городами посещения сталиМагадан,Хабаровск,Новосибирски Горно-Алтайск.'}], 'price_forecast_summary': 'По данным Аналитический хаб прогнозируются цены на: Пшеница 1-го класса 2026 - 13.9 руб/кг без НДС (-4.8% к АППГ), 2027 - 14.3 руб/кг без НДС (+2.9% к АППГ); Пшеница 3-го класса 2026 - 14.7 руб/кг без НДС (-3.3% к АППГ), 2027 - 15.0 руб/кг без НДС (+2.0% к АППГ); Пшеница 5-го класса 2026 - 13.2 руб/кг без НДС (-6.4% к АППГ), 2027 - 13.5 руб/кг без НДС (+2.3% к АППГ); Подсолнечник 2026 - 33.4 руб/кг без НДС (-7.2% к АППГ), 2027 - 34.3 руб/кг без НДС (+2.7% к АППГ); Кукуруза 2026 - 14.4 руб/кг без НДС (+1.4% к АППГ), 2027 - 14.8 руб/кг без НДС (+2.8% к АППГ).', 'programs_analysis': {'passed': [{'program_name': "Программа льготного кредитования 'МСХ'", 'base_conditions': '\n- **Цели кредита:** Оборотное/инвестиционное/проектное финансирование в соответствии с ДКЦ.\n- **Типы кредитов:** Краткосрочные (до 1 года) и инвестиционные (от 2 до 15 лет).\n- **Ставка:** неприоритетное направление - 0,5КС+2%, приоритетное направление - 0,3КС+2%, ИСКЛЮЧЕНИЕ (производство лечеб питания) - 2%\n- **Размер субсидии:** Расчетный годовой размер субсидии зависит от направления:\n  - *Приоритетное:* 0,7 * КС * (Лимит кредита)\n  - *Неприоритетное:* 0,5 * КС * (Лимит кредита)\n  - *Исключение (лечеб. питание):* 1,0 * КС * (Лимит кредита)\n- **Основное требование:** Наличие свободных лимитов субсидий по региону и направлению деятельности заемщика.\n- **Режим кредитования:** НКЛ.\n', 'passed': True, 'calculated_conditions': "Ваша процентная ставка рассчитывается от Ключевой Ставки ЦБ (18.00% на 15.08.2025).\nВаше направление 'Растениеводство' является приоритетным. Расчет ставки:\n(0.3 * 18.00% КС) + 2% = **7.40% годовых**.", 'manual_steps': '- Предоставить в банк справки: об отсутствии задолженности (ФНС), о статусе сельхозтоваропроизводителя (форма 6-АПК).\n- Расчетный размер годовой субсидии: **75 600 000.00 рублей**.\n\nДополнительно: Более подробно с направлениями целевого использования можете ознакомиться по [ссылке](https://mcx.gov.ru/activity/state-support/measures/preferential-credit/).', 'check_log': ['Шаг 1: Проверка наличия компании в ЕГРЮЛ и базовых данных.', '✅ РЕЗУЛЬТАТ: Компания найдена в ЕГРЮЛ, данные по ОКВЭД присутствуют.', 'Шаг 2: Проверка соответствия ОКВЭД требованиям программы.', '✅ РЕЗУЛЬТАТ: Найдены соответствующие ОКВЭД: 01.41, 10.41.2, 01.11.31, 01.13.3, 01.11.3, 01.11, 01.42, 10.71, 01.11.2, 01.11.33, 01.13.1, 01.13.51, 01.11.1, 10.73.1.', "Шаг 3: Определение статуса ОКВЭД ('уточнение', 'приоритетный').", "   - Определена релевантная категория 'Растениеводство' (Приоритет: True).", 'Шаг 4: Проверка доли иностранных учредителей из офшорных зон.', '✅ РЕЗУЛЬТАТ: Доля офшоров (0%) не превышает 25%.', 'Шаг 5: Расчет ставки.', '✅ РЕЗУЛЬТАТ: Ставка успешно рассчитана.', 'Шаг 6: Формирование текста для ручной проверки и примечаний.', 'Шаг 7: Расчет размера субсидии.', '   - Субсидия рассчитана: - Расчетный размер годовой субсидии: **75 600 000.00 рублей**.']}], 'fixable': [{'program_name': "Программа поддержки 'Беларусь'", 'base_conditions': '\n- **Цели кредита:** Приобретение товаров, произведенных в Республике Беларусь (техника, оборудование и т.д.).\n- **Сумма кредита:** До 90% от стоимости товара. Для продукции ОАО «БЕЛАЗ» - до 70%.\n- **Валюта и срок:** Кредит выдается в рублях РФ на срок до 5 лет.\n- **Общий принцип ставки:** Ставка для заемщика субсидируется Правительством Республики Беларусь, что делает ее значительно ниже рыночной.\n', 'passed': False, 'reason': 'Обнаружен дополнительный ОКВЭД (77.31 - Аренда и лизинг сельскохозяйственных машин и оборудования), связанный с лизингом/арендой.', 'recommendation': 'Для участия в программе рассмотрите возможность исключения данного вида деятельности из ЕГРЮЛ.', 'check_log': ['Шаг 1: Проверка наличия компании в ЕГРЮЛ (на основе ранее собранных данных).', '✅ РЕЗУЛЬТАТ: Компания найдена в ЕГРЮЛ.', 'Шаг 2: Анализ видов деятельности (ОКВЭД).', '❌ РЕЗУЛЬТАТ: Обнаружен дополнительный ОКВЭД (77.31 - Аренда и лизинг сельскохозяйственных машин и оборудования), связанный с лизингом/арендой.'], 'calculated_conditions': None}], 'failed': [{'program_name': "Программа 'Новые территории' (СЭЗ)", 'base_conditions': '\n- **Цели кредита:** Реализация инвестиционных проектов на территориях СЭЗ (ДНР, ЛНР, Запорожская и Херсонская области). До 20% от суммы кредита можно направить на пополнение оборотных средств.\n- **Сумма кредита:** От 1 миллиона до 5 миллиардов рублей.\n- **Срок:** До 5 лет.\n- **Общий принцип ставки:** Плавающая ставка, привязанная к Ключевой ставке ЦБ, но с государственной субсидией, значительно снижающей итоговую стоимость кредита для заемщика.\n- **Основное требование:** Компания должна быть участником свободной экономической зоны (СЭЗ).\n', 'passed': False, 'reason': 'Компания не найдена в едином реестре участников свободной экономической зоны (СЭЗ).', 'check_log': ['Шаг 1: Проверка нахождения компании в Едином реестре участников СЭЗ.', '❌ РЕЗУЛЬТАТ: Компания не найдена в реестре СЭЗ.'], 'calculated_conditions': None}, {'program_name': "Программа 'КМСП Приграничье'", 'base_conditions': '\n- **Территория действия:** Программа доступна для предпринимателей, зарегистрированных и ведущих деятельность в Курской, Белгородской и Брянской областях.\n- **Цели кредита:** Оборотное и инвестиционное кредитование, а также рефинансирование ранее полученных кредитов.\n- **Сумма кредита:** До 30 миллионов рублей.\n- **Срок:** До 12 месяцев.\n- **Ставка:** Равна Ключевой ставке ЦБ РФ на дату заключения договора.\n- **Основные требования:** Отсутствие процедуры банкротства, соответствие ОКВЭД правилам программы.\n', 'passed': False, 'reason': "Регион компании ('воронежская область') не входит в перечень приграничных.", 'check_log': ['Шаг 1: Анализ данных о компании для определения региона и ОКВЭД.', "Шаг 2: Проверка региона компании ('воронежская область') на вхождение в список приграничных.", '❌ РЕЗУЛЬТАТ: Регион не входит в перечень (Курская, Белгородская, Брянская области).'], 'calculated_conditions': None}, {'program_name': "МЭР-2025 'Совмещенная' (Комбо 2.0)", 'base_conditions': '\n- **Цели кредита:** Инвестиционные цели, такие как приобретение или создание основных средств, запуск новых производств. До 20% от суммы кредита можно направить на пополнение оборотных средств.\n- **Срок:** До 10 лет, при этом период субсидирования процентной ставки составляет 5 лет.\n- **Сумма кредита:** От 50 миллионов рублей. Максимальный лимит зависит от категории субъекта МСП (микро, малое или среднее предприятие).\n- **Общий принцип ставки:** Плавающая ставка, привязанная к Ключевой ставке ЦБ РФ, но субсидируемая государством.\n- **Основные требования:** Компания должна быть в реестре МСП, основной ОКВЭД должен относиться к приоритетным отраслям (обрабатывающие производства, IT, туризм и др.), и отсутствовать запрещенные виды деятельности.\n', 'passed': False, 'reason': 'Компания не найдена в Едином реестре субъектов МСП.', 'check_log': ['Шаг 1: Проверка в Едином реестре субъектов МСП.', '❌ РЕЗУЛЬТАТ: Компания не найдена в реестре МСП.'], 'calculated_conditions': None}]}}, 'history': [{'role': 'assistant', 'content': "✅ **Комплексный анализ для «Компания с ИНН 3620007636» (ИНН: 3620007636)**\n\n--- **1. САМОЕ ИНТЕРЕСНОЕ В АПК ЗА ПОСЛЕДНЕЕ ВРЕМЯ (Агроинвестор)** ---\n📰 Депутаты предложили отменить пошлину на экспорт зерна до 2027 года\n📰 Цены на зерно ниже ожиданий производителей\n📰 Росстатподвел итоги посевной кампании\n\n   **Источник подборки:** https://www.agroinvestor.ru/markets\n\n\n--- **2. АКТУАЛЬНЫЕ НОВОСТИ ПО ПРОГНОЗУ УРОЖАЯ (РИА Новости)** ---\n📰 **Мировые цены на продовольствие в июле выросли до максимума с 2023 года**\n   **Источник:** https://ria.ru/20250808/produkty-2034129363.html\n📰 **Минсельхоз сохранил прогноз урожая зерновых на 2025 год**\n   **Источник:** https://ria.ru/20250728/minselhoz-2031841877.html\n📰 **\ufeffМишустин проведет в Забайкалье совещание по вопросу экспорта зерна**\n   **Источник:** https://ria.ru/20250722/mishustin-2030512898.html\n\n\n--- **3. ОТРАСЛЕВОЙ ПРОГНОЗ ЦЕН** ---\nПо данным Аналитический хаб прогнозируются цены на: Пшеница 1-го класса 2026 - 13.9 руб/кг без НДС (-4.8% к АППГ), 2027 - 14.3 руб/кг без НДС (+2.9% к АППГ); Пшеница 3-го класса 2026 - 14.7 руб/кг без НДС (-3.3% к АППГ), 2027 - 15.0 руб/кг без НДС (+2.0% к АППГ); Пшеница 5-го класса 2026 - 13.2 руб/кг без НДС (-6.4% к АППГ), 2027 - 13.5 руб/кг без НДС (+2.3% к АППГ); Подсолнечник 2026 - 33.4 руб/кг без НДС (-7.2% к АППГ), 2027 - 34.3 руб/кг без НДС (+2.7% к АППГ); Кукуруза 2026 - 14.4 руб/кг без НДС (+1.4% к АППГ), 2027 - 14.8 руб/кг без НДС (+2.8% к АППГ).\n\n\n--- **4. АНАЛИЗ ПО ГОСПРОГРАММАМ** ---\n\n**✅ ПРЕДВАРИТЕЛЬНО ПРОХОДИТ:**\n\n➡️ **Программа:** Программа льготного кредитования 'МСХ'\n   **Условия:** Ваша процентная ставка рассчитывается от Ключевой Ставки ЦБ (18.00% на 15.08.2025).\nВаше направление 'Растениеводство' является приоритетным. Расчет ставки:\n(0.3 * 18.00% КС) + 2% = **7.40% годовых**.\n\n**⚠️ ТРЕБУЮТ КОРРЕКТИРОВКИ:**\n\n➡️ **Программа:** Программа поддержки 'Беларусь'\n   **РЕКОМЕНДАЦИЯ:** Для участия в программе рассмотрите возможность исключения данного вида деятельности из ЕГРЮЛ.\n\n**❌ НЕ ПРОХОДИТ:**\n\n➡️ **Программа:** Программа 'Новые территории' (СЭЗ)\n   **Причина отказа:** Компания не найдена в едином реестре участников свободной экономической зоны (СЭЗ).\n\n➡️ **Программа:** Программа 'КМСП Приграничье'\n   **Причина отказа:** Регион компании ('воронежская область') не входит в перечень приграничных.\n\n➡️ **Программа:** МЭР-2025 'Совмещенная' (Комбо 2.0)\n   **Причина отказа:** Компания не найдена в Едином реестре субъектов МСП.\n\n\n---\nЯ проанализировал всю доступную информацию. **Вы можете задать любой уточняющий вопрос** по деталям отчета."}, {'role': 'user', 'content': 'максимальный лимит на заемщика в регионе'}, {'role': 'assistant', 'content': '✅ **Актуальный остаток субсидий для одного заемщика в регионе «Воронежская область»**:\n\n- **Краткосрочное кредитование:** 231 200 468.87 рублей\n- **Малые формы:** 36 068 210.93 рублей\n- **Растениеводство:** 106 393 137.62 рублей\n- **Животноводство:** 34 880 067.34 рублей\n- **Переработка продукции растениеводства и животноводства:** 20 844 739.45 рублей\n- **Молочное скотоводство:** 30 554 014.77 рублей\n- **Мясное скотоводство:** 2 460 298.76 рублей'}, {'role': 'user', 'content': 'скорлько можно выдать клиенту кредит'}], 'company_region': 'Воронежская область'}
